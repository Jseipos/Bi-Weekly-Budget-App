# Path to the SQLite database file.
# Inside Docker this should point to a path within the mounted /app/data volume.
DATABASE_URL=/app/data/budget.db

# Secret used to sign session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Base path where iCloud Drive is mounted inside the container.
# The docker-compose.yml maps ~/Library/Mobile Documents/com~apple~CloudDocs to this path.
ICLOUD_BASE_PATH=/app/icloud

# Maximum upload size in bytes for receipt files (default: 10 MB).
MAX_UPLOAD_SIZE=10485760

# Set to "true" ONLY when the app is served over HTTPS (e.g. Tailscale MagicDNS
# + HTTPS certs, or a Cloudflare Tunnel). Leave unset/false for plain HTTP
# access over Tailscale — iOS Safari drops Secure cookies over HTTP and you
# won't be able to log in.
COOKIE_SECURE=false
